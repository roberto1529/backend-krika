datasource db {
  provider = "mysql"
  url      = env("mysql://admin:Krika2025**@localhost:3306/krika")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id         Int      @id @default(autoincrement())
  nombre     String
  apellido   String
  correo     String   @unique
  contrasena String
  rol        Rol      @default(USUARIO)
  tareas     Tarea[]  @relation("ResponsableTareas")
  createdAt  DateTime @default(now())
}

model Tarea {
  id            Int      @id @default(autoincrement())
  nombre        String
  responsable   Usuario  @relation("ResponsableTareas", fields: [responsableId], references: [id])
  responsableId Int
  estado        Estado   @default(POR_HACER)
  createdAt     DateTime @default(now())
}

enum Rol {
  USUARIO
  ADMINISTRADOR
}

enum Estado {
  POR_HACER
  EN_PROGRESO
  FINALIZADO
  CANCELADO
}
